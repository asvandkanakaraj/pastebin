{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "Node16",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true
    // "baseUrl": "." is omitted to avoid TS5102 error in modern TypeScript when moduleResolution is Node16
  },
  "exclude": ["node_modules", "dist"]
}
