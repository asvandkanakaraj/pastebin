# PasteBin - Environment Variables Template
# Copy this file to .env or .env.production and fill in your values

# 1. Database Connection (PostgreSQL)
# For local dev: postgresql://username:password@localhost:5432/pastebin
# For Render/Neon: postgresql://user:pass@ep-host.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/pastebin?schema=public"

# 2. Server Configuration
PORT=5000
NODE_ENV="development" # or "production"

# 3. Security & Sessions
# Generate a secure random string in production (e.g. openssl rand -base64 32)
JWT_SECRET="your-super-secret-key-change-this-in-production"

# 4. CORS Allowed Origins
# Comma-separated list of origins allowed to request the API server
CORS_ORIGIN="http://localhost:5173"
