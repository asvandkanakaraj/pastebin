datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           String       @id @default(uuid())
  email        String       @unique
  username     String       @unique
  passwordHash String
  pastes       Paste[]
  shares       Share[]
  savedPastes  SavedPaste[]
  recentViews  RecentView[]
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
}

model Paste {
  id           String       @id @default(cuid())
  title        String?
  description  String?
  content      String
  language     String       @default("plaintext")
  isPublic     Boolean      @default(true)
  visibility   String       @default("PUBLIC")
  passwordHash String?
  expiresAt    DateTime?
  userId       String?
  user         User?        @relation(fields: [userId], references: [id], onDelete: Cascade)
  shares       Share[]
  savedPastes  SavedPaste[]
  recentViews  RecentView[]
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([userId])
  @@index([expiresAt])
}

model Share {
  id        String   @id @default(uuid())
  pasteId   String
  paste     Paste    @relation(fields: [pasteId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([pasteId, userId])
}

model SavedPaste {
  id        String   @id @default(uuid())
  pasteId   String
  paste     Paste    @relation(fields: [pasteId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([pasteId, userId])
}

model RecentView {
  id        String   @id @default(uuid())
  pasteId   String
  paste     Paste    @relation(fields: [pasteId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  viewedAt  DateTime @default(now()) @updatedAt

  @@unique([pasteId, userId])
}
