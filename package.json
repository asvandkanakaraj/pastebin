{
  "name": "pastebin-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "High-performance full-stack code-sharing platform monorepo",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspaces --if-present",
    "build": "npm run build -w @pastebin/shared && npm run build -w @pastebin/database && npm run build -w @pastebin/server && npm run build -w web",
    "build:prod": "npm run build -w @pastebin/shared && npm run build -w @pastebin/database && npm run build -w @pastebin/server && npm run build -w web",
    "lint": "npm run lint --workspaces --if-present",
    "format": "prettier --write .",
    "test": "npm run test --workspaces --if-present",
    "cli": "npm run start -w @pastebin/cli"
  },
  "devDependencies": {
    "typescript": "^7.0.2"
  },
  "overrides": {
    "brace-expansion": "^2.0.1",
    "tar": "^6.2.1",
    "minimatch": {
      "brace-expansion": "^2.0.1"
    },
    "glob": {
      "minimatch": {
        "brace-expansion": "^2.0.1"
      }
    },
    "@mapbox/node-pre-gyp": {
      "rimraf": {
        "glob": {
          "minimatch": {
            "brace-expansion": "^2.0.1"
          }
        }
      },
      "tar": "^6.2.1"
    }
  }
}
