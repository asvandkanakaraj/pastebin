{
  "name": "pastebin-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "High-performance full-stack code-sharing platform monorepo",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "format": "prettier --write .",
    "test": "npm run test --workspaces --if-present",
    "cli": "npm run start -w @pastebin/cli"
  },
  "devDependencies": {
    "typescript": "^7.0.2"
  }
}
